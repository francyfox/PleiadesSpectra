{
	"name": "PleiadesSpectra",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check-types": "turbo run check-types",
		"e2e": "bun run --cwd apps/e2e test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@faker-js/faker": "^10.6.0",
		"turbo": "^2.11.13",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.3"
		}
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"typescript": "7.0.2"
		}
	}
}
